# ---- Geral ----
MONITOR_DB_PATH=data/monitor.db
MONITOR_SOURCES_FILE=config/sources.toml
LOG_LEVEL=INFO
HTTP_TIMEOUT=25
MAX_MESSAGES_PER_RUN=8
FAILURE_ALERT_THRESHOLD=3
# true = também envia alertas do que já existia na 1ª execução
NOTIFY_BASELINE=false

# ---- Canais (separe por vírgula): callmebot, whatsapp_cloud, email, console ----
NOTIFY_CHANNELS=console

# ---- WhatsApp via CallMeBot (uso pessoal, gratuito, não oficial) ----
CALLMEBOT_PHONE=+5547999999999
CALLMEBOT_APIKEY=

# ---- WhatsApp Cloud API (oficial da Meta) ----
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_TO=5547999999999
WHATSAPP_API_VERSION=v21.0

# ---- E-mail (opcional, backup) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
